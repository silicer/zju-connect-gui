import { Theme } from "theme.slint";
import {
    Button, GroupBox, HorizontalBox, LineEdit, ScrollView, Switch, TextEdit,
    VerticalBox,
} from "std-widgets.slint";

component LabeledLineEdit inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> text;
    spacing: Theme.space-1;
    Text {
        text: root.label;
        color: Theme.ink-body;
        font-size: Theme.font-caption-size;
        font-weight: 600;
    }
    LineEdit {
        text <=> root.text;
        placeholder-text: root.placeholder;
        input-type: root.password ? InputType.password : InputType.text;
    }
}

export component SettingsPanel inherits Rectangle {
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> socks-bind;
    in-out property <string> http-bind;
    in-out property <bool> proxy-only;
    in-out property <bool> debug-dump;
    in-out property <bool> eip-options-expanded;
    in-out property <string> eip-browser-program;
    in-out property <string> eip-browser-args;
    callback pick-eip-browser();
    callback clear-eip-browser();

    background: transparent;

    ScrollView {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        VerticalBox {
            spacing: Theme.space-4;

            GroupBox {
                title: "账号认证";
                VerticalBox {
                    spacing: Theme.space-3;
                    Text {
                        text: "使用认证信息发起连接。";
                        color: Theme.ink-muted;
                        font-size: Theme.font-caption-size;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        spacing: Theme.space-3;
                        LabeledLineEdit {
                            label: "用户名";
                            text <=> root.username;
                            horizontal-stretch: 1;
                        }
                        LabeledLineEdit {
                            label: "密码";
                            password: true;
                            text <=> root.password;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            GroupBox {
                title: "本地代理";
                VerticalBox {
                    spacing: Theme.space-3;
                    Text {
                        text: "保持 SOCKS 与 HTTP 两组监听地址，供本机应用接入。";
                        color: Theme.ink-muted;
                        font-size: Theme.font-caption-size;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        spacing: Theme.space-3;
                        LabeledLineEdit {
                            label: "SOCKS 监听地址";
                            text <=> root.socks-bind;
                            horizontal-stretch: 1;
                        }
                        LabeledLineEdit {
                            label: "HTTP 监听地址";
                            text <=> root.http-bind;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            GroupBox {
                title: "运行方式";
                VerticalBox {
                    spacing: Theme.space-3;
                    HorizontalBox {
                        Switch {
                            text: "仅代理模式";
                            checked <=> root.proxy-only;
                        }
                        HorizontalBox { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "开启后仅保留本地 SOCKS / HTTP 代理；关闭后还会启用 TUN 与系统路由（Windows 需以管理员身份重启 GUI）。";
                        color: Theme.ink-muted;
                        font-size: Theme.font-caption-size;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        Switch {
                            text: "调试模式";
                            checked <=> root.debug-dump;
                        }
                        HorizontalBox { horizontal-stretch: 1; }
                    }
                    Text {
                        text: "保留更详细的诊断输出，便于排查连接问题。";
                        color: Theme.ink-muted;
                        font-size: Theme.font-caption-size;
                        wrap: word-wrap;
                    }
                }
            }

            GroupBox {
                title: "EIP 打开设置";
                VerticalBox {
                    spacing: Theme.space-3;
                    HorizontalBox {
                        spacing: Theme.space-3;
                        Text {
                            text: "默认折叠，可按需指定浏览器程序和附加参数。";
                            color: Theme.ink-muted;
                            font-size: Theme.font-caption-size;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        Button {
                            text: root.eip-options-expanded ? "收起" : "展开";
                            clicked => {
                                root.eip-options-expanded = !root.eip-options-expanded;
                            }
                        }
                    }
                    if root.eip-options-expanded: VerticalBox {
                        spacing: Theme.space-3;
                        LabeledLineEdit {
                            label: "浏览器程序路径";
                            placeholder: "留空则使用系统默认浏览器";
                            text <=> root.eip-browser-program;
                        }
                        HorizontalBox {
                            spacing: Theme.space-2;
                            Button {
                                text: "浏览...";
                                clicked => { root.pick-eip-browser(); }
                            }
                            if root.eip-browser-program != "": Button {
                                text: "清空";
                                clicked => { root.clear-eip-browser(); }
                            }
                            HorizontalBox { horizontal-stretch: 1; }
                        }
                        Text {
                            text: "浏览器参数（每行一个，启动时会自动追加 URL）";
                            color: Theme.ink-body;
                            font-size: Theme.font-caption-size;
                            font-weight: 600;
                        }
                        Rectangle {
                            height: 110px;
                            background: Theme.surface-primary;
                            border-color: Theme.line-soft;
                            border-width: 1px;
                            border-radius: Theme.radius-s;
                            TextEdit {
                                x: Theme.space-2;
                                y: Theme.space-2;
                                width: parent.width - Theme.space-2 * 2;
                                height: parent.height - Theme.space-2 * 2;
                                text <=> root.eip-browser-args;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
