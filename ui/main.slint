import { Theme } from "theme.slint";
import { SettingsPanel } from "settings_panel.slint";
import { LogsPanel } from "logs_panel.slint";
import { CaptchaModal, CaptchaPoint, InputModal } from "modals.slint";
import { Button, HorizontalBox, TabWidget, VerticalBox } from "std-widgets.slint";

export { CaptchaPoint }

export component AppWindow inherits Window {
    title: "ZJU Connect GUI";
    // The min sizes target the smallest realistic Windows desktop logical
    // viewport (~911×512 = 1366×768 @ 150%). Two-column LineEdits need ~700px
    // for usable input fields; modals (max 540×~440) clamp themselves to the
    // viewport in modals.slint so they never overflow at this floor.
    min-width: 700px;
    min-height: 520px;
    preferred-width: 960px;
    preferred-height: 720px;
    background: Theme.page-base;
    default-font-family: Theme.font-display-family;
    default-font-size: Theme.font-body-size;

    // ---- Properties driven from Rust ----
    in-out property <bool> running: false;
    in-out property <string> status-message: "";
    in-out property <[string]> logs: [];

    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> socks-bind: "127.0.0.1:1080";
    in-out property <string> http-bind: "127.0.0.1:8888";
    in-out property <bool> proxy-only: false;
    in-out property <bool> debug-dump: false;
    in-out property <bool> eip-options-expanded: false;
    in-out property <string> eip-browser-program: "";
    in-out property <string> eip-browser-args: "";

    // Modal state
    in-out property <bool> modal-open: false;
    in-out property <int> modal-type: 0;       // 0 input, 1 captcha
    in-out property <int> modal-input-kind: 0; // 0 generic, 1 sms
    in-out property <string> modal-title: "";
    in-out property <string> modal-prompt: "";
    in-out property <string> modal-input: "";
    in-out property <image> captcha-image;
    in-out property <int> captcha-natural-width: 0;
    in-out property <int> captcha-natural-height: 0;
    in-out property <[CaptchaPoint]> captcha-points: [];

    // ---- Callbacks to Rust ----
    callback start();
    callback stop();
    callback submit-input(string);
    callback submit-captcha(int, int);
    callback cancel-modal();
    callback clear-logs();
    callback pick-eip-browser();
    callback clear-eip-browser();
    callback persist-options();
    callback add-captcha-point(int, int);
    callback remove-last-captcha-point();
    callback clear-captcha-points();
    // Triggered by tray "退出" or by the window close button when no tray is
    // available. Rust handles graceful proxy shutdown then quits the event loop.
    callback request-quit();

    // Auto-fire persist-options when any persisted option changes.
    changed username => { root.persist-options(); }
    changed password => { root.persist-options(); }
    changed socks-bind => { root.persist-options(); }
    changed http-bind => { root.persist-options(); }
    changed proxy-only => { root.persist-options(); }
    changed debug-dump => { root.persist-options(); }
    changed eip-browser-program => { root.persist-options(); }
    changed eip-browser-args => { root.persist-options(); }

    VerticalBox {
        // Header — title + status pill
        HorizontalBox {
            spacing: Theme.space-3;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: "ZJU Connect GUI";
                    color: Theme.ink-strong;
                    font-size: Theme.font-display-size;
                    font-weight: 700;
                }
                Text {
                    text: "基于 zju-connect CLI 的桌面控制台";
                    color: Theme.ink-muted;
                    font-size: Theme.font-caption-size;
                }
            }
            Rectangle {
                height: 30px;
                width: status-chip-layout.preferred-width;
                background: Theme.surface-primary;
                border-color: Theme.line-soft;
                border-width: 1px;
                border-radius: Theme.radius-s;

                status-chip-layout := HorizontalLayout {
                    padding-left: Theme.space-3;
                    padding-right: Theme.space-3;
                    spacing: Theme.space-2;
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: root.running ? Theme.accent : Theme.danger;
                    }
                    Text {
                        text: root.running ? "已连接" : "未连接";
                        color: Theme.ink-body;
                        font-size: Theme.font-caption-size;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Status banner — shown only when there's a message to surface
        if root.status-message != "": Rectangle {
            background: Theme.surface-warning;
            border-color: Theme.warning;
            border-width: 1px;
            border-radius: Theme.radius-s;
            height: status-text.preferred-height + Theme.space-3 * 2;
            status-text := Text {
                x: Theme.space-3;
                y: Theme.space-3;
                width: parent.width - Theme.space-3 * 2;
                text: root.status-message;
                color: Theme.warning;
                font-size: Theme.font-body-size;
                wrap: word-wrap;
            }
        }

        // Tab area — std-widgets TabWidget owns its own current-index state
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "配置";
                SettingsPanel {
                    username <=> root.username;
                    password <=> root.password;
                    socks-bind <=> root.socks-bind;
                    http-bind <=> root.http-bind;
                    proxy-only <=> root.proxy-only;
                    debug-dump <=> root.debug-dump;
                    eip-options-expanded <=> root.eip-options-expanded;
                    eip-browser-program <=> root.eip-browser-program;
                    eip-browser-args <=> root.eip-browser-args;
                    pick-eip-browser => { root.pick-eip-browser(); }
                    clear-eip-browser => { root.clear-eip-browser(); }
                }
            }
            Tab {
                title: "日志";
                LogsPanel {
                    logs: root.logs;
                    clear-logs => { root.clear-logs(); }
                }
            }
        }

        // Bottom action bar — primary connect/disconnect button
        HorizontalBox {
            HorizontalLayout { horizontal-stretch: 1; }
            Button {
                text: root.running ? "断开连接" : "立即连接";
                primary: !root.running;
                clicked => {
                    if (root.running) { root.stop(); } else { root.start(); }
                }
            }
        }
    }

    // Modal overlays sit on top of everything when modal-open is true.
    if root.modal-open && root.modal-type == 0: InputModal {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.modal-title;
        prompt: root.modal-prompt;
        sms: root.modal-input-kind == 1;
        input <=> root.modal-input;
        submit => { root.submit-input(root.modal-input); }
        cancel => { root.cancel-modal(); }
    }
    if root.modal-open && root.modal-type == 1: CaptchaModal {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        prompt: root.modal-prompt;
        captcha-image: root.captcha-image;
        natural-width: root.captcha-natural-width;
        natural-height: root.captcha-natural-height;
        points: root.captcha-points;
        add-point(x, y) => { root.add-captcha-point(x, y); }
        remove-last => { root.remove-last-captcha-point(); }
        clear-points => { root.clear-captcha-points(); }
        submit => {
            root.submit-captcha(root.captcha-natural-width, root.captcha-natural-height);
        }
        cancel => { root.cancel-modal(); }
    }
}
